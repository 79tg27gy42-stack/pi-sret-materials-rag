MP_API_KEY=replace_with_your_materials_project_api_key

# Qwen / Alibaba Cloud DashScope via OpenAI-compatible API.
LLM_PROVIDER=qwen
DASHSCOPE_API_KEY=replace_with_your_dashscope_api_key
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_GENERATION_MODEL=qwen-max
QWEN_JUDGE_MODEL=qwen-max

# OpenAI fallback/final experiment settings.
OPENAI_API_KEY=replace_with_your_openai_api_key
OPENAI_GENERATION_MODEL=gpt-4.1-mini
OPENAI_JUDGE_MODEL=gpt-4.1-mini
